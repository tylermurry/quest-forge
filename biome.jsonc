{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.{ts,tsx,js,json,jsonc,css}",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!docs/.docusaurus",
      "!packages/editor/src-tauri/target",
      "!packages/editor/.sandbox",
      "!packages/editor/src/platform/bindings.ts",
      "!pnpm-lock.yaml",
      "!packages/engine/fixtures",
      "!packages/schema/test/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Deliberate style: with noUncheckedIndexedAccess the code asserts non-null where an invariant guarantees it (854 uses).
        "noNonNullAssertion": "off"
      },
      "correctness": {
        // Deliberate exceptions carry a biome-ignore with their reason.
        "useExhaustiveDependencies": "error"
      },
      "suspicious": {
        // `then` is a dialogue graph port name in the schema, not a thenable (6).
        "noThenProperty": "off"
      },
      "a11y": {
        // Real accessibility findings in the editor UI, existing, follow-up #30 (49 in total).
        "useButtonType": "off", // 21
        "useAriaPropsSupportedByRole": "off", // 7
        "useSemanticElements": "off", // 6
        "useFocusableInteractive": "off", // 4
        "noStaticElementInteractions": "off", // 2
        "noLabelWithoutControl": "off", // 2
        "useMediaCaption": "off", // 1
        "noNoninteractiveTabindex": "off", // 1
        "noNoninteractiveElementToInteractiveRole": "off", // 1
        "noAutofocus": "off" // 1
      }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "off" } } }
}
